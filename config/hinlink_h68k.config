# =====================================================
# ImmortalWrt 定制固件 seed 配置 — HINLINK H68K (F版 WiFi)
# =====================================================

# ---------- 平台 / 设备 ----------
# 实测 run2：单设备模式 kconfig 键为 CONFIG_TARGET_<target>_<subtarget>_DEVICE_<device>
#（不带 DEVICE_rockchip_armv8 前缀；此前写错导致被忽略）
CONFIG_TARGET_rockchip=y
CONFIG_TARGET_rockchip_armv8=y
CONFIG_TARGET_rockchip_armv8_DEVICE_hinlink_h68k=y
CONFIG_TARGET_KERNEL_PARTSIZE=256
CONFIG_TARGET_ROOTFS_PARTSIZE=1024
CONFIG_TARGET_ROOTFS_SQUASHFS=y
CONFIG_TARGET_ROOTFS_EXT4FS=y
CONFIG_TARGET_ROOTFS_TARGZ=n
# CONFIG_SIGNATURE_CHECK is not set

# ---------- LuCI 基本 ----------
# NLS 必须开，否则所有 luci-i18n-*-zh-cn 会被 kconfig 静默忽略（run2 实锤）
CONFIG_BUILD_NLS=y
CONFIG_NLS_UTF8=y
CONFIG_NLS_CODEPAGE_936=y
CONFIG_PACKAGE_luci=y
CONFIG_LUCI_LANG_zh_Hans=y
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
CONFIG_PACKAGE_luci-compat=y

# ---------- 无线（MT7921，profile 已含 wpad-basic-mbedtls，这里双保险） ----------
CONFIG_PACKAGE_kmod-mt7921e=y
CONFIG_PACKAGE_wpad-basic-mbedtls=y

# ---------- 网口/SATA 驱动（profile 已含，显式双保险：run5 发现 profile 自动带入未生效） ----------
CONFIG_PACKAGE_kmod-r8169=y
CONFIG_PACKAGE_kmod-ata-ahci-dwc=y

# ---------- USB 存储 / 磁盘挂载（SMB+文件管理器配套） ----------
CONFIG_PACKAGE_block-mount=y
CONFIG_PACKAGE_kmod-usb-storage=y
CONFIG_PACKAGE_kmod-usb3=y
CONFIG_PACKAGE_kmod-fs-vfat=y
CONFIG_PACKAGE_kmod-fs-exfat=y
CONFIG_PACKAGE_kmod-nls-utf8=y
CONFIG_PACKAGE_kmod-nls-iso8859-1=y
CONFIG_PACKAGE_ntfs-3g=y
CONFIG_PACKAGE_fdisk=y
CONFIG_PACKAGE_lsblk=y
CONFIG_PACKAGE_parted=y
CONFIG_PACKAGE_e2fsprogs=y

# ---------- 常用小工具 / 基础网络 ----------
CONFIG_PACKAGE_ca-bundle=y
CONFIG_PACKAGE_tar=y
CONFIG_PACKAGE_resolveip=y
CONFIG_PACKAGE_luci-i18n-upnp-zh-cn=y
CONFIG_PACKAGE_luci-i18n-ddns-zh-cn=y

#通用组件
CONFIG_PACKAGE_bash=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_nano=y
CONFIG_PACKAGE_pciutils=y
CONFIG_PACKAGE_lm-sensors=m
CONFIG_PACKAGE_mmc-utils=y
CONFIG_PACKAGE_rclone=y
CONFIG_PACKAGE_socat=y
CONFIG_PACKAGE_unzip=y
CONFIG_PACKAGE_wget=y
CONFIG_PACKAGE_vsftpd-alt=y
CONFIG_PACKAGE_zstd=m
CONFIG_PACKAGE_kmod-usb-printer=y
CONFIG_PACKAGE_kmod-netlink-diag=y
CONFIG_PACKAGE_kmod-inet-diag=y
CONFIG_PACKAGE_kmod-i2c-core=y

#插件区
CONFIG_PACKAGE_ariang=y
CONFIG_PACKAGE_luci-i18n-aria2-zh-cn=y
CONFIG_PACKAGE_luci-i18n-diskman-zh-cn=y
CONFIG_PACKAGE_luci-i18n-dockerman-zh-cn=y
CONFIG_PACKAGE_luci-i18n-hd-idle-zh-cn=y
CONFIG_PACKAGE_luci-i18n-mwan3-zh-cn=y
CONFIG_PACKAGE_luci-i18n-mwan3helper-zh-cn=m
CONFIG_PACKAGE_luci-i18n-nfs-zh-cn=y
CONFIG_PACKAGE_luci-i18n-ramfree-zh-cn=y
CONFIG_PACKAGE_luci-i18n-samba4-zh-cn=y
CONFIG_PACKAGE_luci-i18n-ssr-plus-zh-cn=y
CONFIG_PACKAGE_luci-i18n-ttyd-zh-cn=m
# CONFIG_PACKAGE_luci-i18n-turboacc-zh-cn=y
CONFIG_PACKAGE_luci-i18n-vlmcsd-zh-cn=y
CONFIG_PACKAGE_luci-i18n-wol-zh-cn=y

#主题
CONFIG_PACKAGE_luci-theme-design=y
